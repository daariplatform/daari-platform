{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "true"
      },
      "ios": { "simulator": true },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "true"
      },
      "android": { "buildType": "apk" }
    },
    "staging": {
      "//": "Real backend, installable APK for BlueStacks/sideload testing.",
      "//demo": "Demo mode OFF — the app hits api.phi-bit.com for real.",
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false"
      },
      "android": { "buildType": "apk" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}

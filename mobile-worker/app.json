{
  "expo": {
    "name": "داري — للعاملين",
    "slug": "daari-worker",
    "scheme": "daariworker",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "owner": "a7medal3ni",
    "description": "داري للعاملين — تطبيق سائقي معامل المياه والبائعين المتجولين على منصّة داري. يعرض مهام اليوم، يثبت التعبئات بموقع GPS، ويحسب العمولات تلقائياً.",
    "primaryColor": "#0891b2",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "apiBaseUrl": "https://api.phi-bit.com/api/v1",
      "developer": {
        "name": "أحمد العاني",
        "company": "Phi-Bit",
        "website": "https://phi-bit.com",
        "supportEmail": "support@phi-bit.com",
        "supportPhone": "+964 0000 000 000"
      },
      "eas": {
        "projectId": "1936e867-7aa8-4f74-b80c-4ec1ac8d1cc8"
      }
    },
    "runtimeVersion": "0.1.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.phibit.daari.worker",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نستخدم موقعك أثناء استخدامك للتطبيق في وردية العمل لتأكيد وصولك للزبون وإظهار موقعك للمعمل. لا نتتبّعك في الخلفية.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.phibit.daari.worker",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "locales": {
      "ar": "./assets/ar.json"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نستخدم موقعك أثناء وردية العمل لتأكيد وصولك للزبون. لا نتتبّعك في الخلفية.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0891b2"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-sqlite",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

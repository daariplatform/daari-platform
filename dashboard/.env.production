# Dashboard — production env (committed; NEXT_PUBLIC_* values are public anyway,
# they get inlined into the JS bundle at build time so there's no hiding them).
#
# Next.js reads this file automatically during `next build` when NODE_ENV=production.
# Don't put secrets here.

NEXT_PUBLIC_API_BASE_URL=https://api.phi-bit.com/api/v1

# PostHog — set NEXT_PUBLIC_POSTHOG_KEY when ready to enable analytics.
# Without a key, posthog.init is a no-op and there's zero overhead.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Dashboard env template — copy to .env.local for dev, .env.production for build.

# Backend API base
NEXT_PUBLIC_API_BASE_URL=http://localhost:3004/api/v1

# PostHog analytics (uses Ahmed's existing PhiBit org per global CLAUDE.md).
# Get the project key from https://posthog.com → Project Settings → Project API Key.
# Leave blank in dev to disable tracking entirely.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

[Unit]
Description=Daari API (NestJS)
Documentation=https://github.com/a7medal3ni/daari-platform
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=daari
Group=daari
WorkingDirectory=/var/www/daari-api
EnvironmentFile=/var/www/daari-api/.env
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=3

# Hardening — runs the process with the minimum capabilities it needs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/daari-api /var/log/daari
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# Memory cap — kills the process if it leaks past 1.5GB rather than letting
# the VPS swap itself to death. Adjust upward if real traffic outgrows it.
MemoryMax=1.5G

StandardOutput=append:/var/log/daari/api.log
StandardError=append:/var/log/daari/api.err.log

[Install]
WantedBy=multi-user.target

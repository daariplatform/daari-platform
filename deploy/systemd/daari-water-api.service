[Unit]
Description=Daari (water plant edition) — NestJS API
Documentation=https://github.com/a7medal3ni/daari-platform
# The system Postgres unit on this VPS is named `postgresql`, not
# `postgresql.service` in After= matters. Redis runs as `redis-server`.
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
# Dedicated user — distinct from the existing `daari` (Dar Al-Safari) user
# that already lives on this VPS. Keeping them isolated means our process
# can never read /home/daari files or vice versa.
User=daari-water
Group=daari-water
WorkingDirectory=/var/www/daari-water-api
EnvironmentFile=/var/www/daari-water-api/.env
# nest build emits to dist/src/main.js (not dist/main.js) because the
# tsconfig doesn't set rootDir — it preserves the src/ prefix.
ExecStart=/usr/bin/node dist/src/main.js
Restart=on-failure
RestartSec=3

# Hardening — runs the process with the minimum capabilities it needs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/daari-water-api /var/log/daari-water
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# Memory cap — kills the process if it leaks past 1.5GB rather than letting
# the VPS swap itself to death. Adjust upward if real traffic outgrows it.
MemoryMax=1.5G

StandardOutput=append:/var/log/daari-water/api.log
StandardError=append:/var/log/daari-water/api.err.log

[Install]
WantedBy=multi-user.target

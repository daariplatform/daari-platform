{
  "expo": {
    "name": "ماء",
    "slug": "maa-customer",
    "scheme": "maacustomer",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "owner": "phibit",
    "description": "تطبيق طلب توصيل مياه الشرب المعقّمة للمنازل في العراق. اطلب تعبئة خزانك بضغطة زر، تابع وصول السائق، واستلم تأكيداً عبر WhatsApp.",
    "primaryColor": "#0891b2",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0891b2"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "REPLACE_WITH_PROJECT_ID_AFTER_eas_init"
      },
      "apiBaseUrl": "https://api.maa-iq.com/api/v1",
      "developer": {
        "name": "أحمد العاني",
        "company": "Phi-Bit",
        "website": "https://phi-bit.com",
        "supportEmail": "support@phi-bit.com",
        "supportPhone": "+964 0000 000 000"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/REPLACE_WITH_PROJECT_ID_AFTER_eas_init",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maaiq.customer",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نحتاج موقعك مرة واحدة فقط لتسجيل عنوان بيتك حتى يصلك الماء بدقة. لا نتتبّعك بعد ذلك.",
        "NSCameraUsageDescription": "لإرفاق صورة (اختياري) مع طلب التعبئة.",
        "NSPhotoLibraryUsageDescription": "لاختيار صورة (اختياري) لإرفاقها بطلبك.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.maaiq.customer",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0891b2"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "ACCESS_BACKGROUND_LOCATION",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "locales": {
      "ar": "./assets/ar.json"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "نستخدم موقعك مرة واحدة فقط لتسجيل عنوان البيت.",
          "locationWhenInUsePermission": "نستخدم موقعك مرة واحدة فقط لتسجيل عنوان البيت.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0891b2"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 34,
            "targetSdkVersion": 34
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

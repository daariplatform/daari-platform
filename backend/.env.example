# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://maa:maa_password@localhost:5432/maa_platform?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (access token). Refresh tokens are opaque random rows in the DB, not
# JWTs, so there is no separate refresh secret/expiry to configure.
JWT_SECRET=replace-with-a-strong-secret-min-32-chars
JWT_EXPIRES_IN=15m

# Google Maps (Iraq)
GOOGLE_MAPS_API_KEY=

# WhatsApp Business API (via Meta or Twilio)
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# SMS (Iraq local provider, e.g. Zain or Asiacell)
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
SMS_SENDER=MAA

# Firebase Cloud Messaging (Push)
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# ZainCash (Iraq payments)
ZAINCASH_MERCHANT_ID=
ZAINCASH_SECRET=
ZAINCASH_MSISDN=

# Notification timing (days)
REMINDER_FIRST_DAYS=25
REMINDER_WARNING_DAYS=35
TANK_RECLAIM_DAYS=45

# GPS geofence radius (metres) for refill arrival detection.
# Tight enough to prevent "fill from down the street" fraud,
# loose enough to absorb urban GPS jitter.
REFILL_GPS_MAX_DISTANCE_M=50

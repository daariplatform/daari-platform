// Maa Platform — Prisma schema
// Multi-tenant SaaS for Iraqi water plant operations.
// Every domain row carries tenantId so a single DB serves many plants safely.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ─── Tenancy & users ──────────────────────────────────────────────────────────

enum SubscriptionPlan {
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

//
// A PlantGroup lets one owner manage multiple branches under one login.
// Each branch (Tenant) keeps its own customers / tanks / accounting,
// but the owner can switch between them or roll up reports across all.
//
model PlantGroup {
  id         String   @id @default(cuid())
  name       String
  ownerName  String
  ownerPhone String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenants Tenant[]

  @@index([ownerPhone])
}

model Tenant {
  id         String @id @default(cuid())
  name       String
  ownerName  String
  ownerPhone String
  city       String

  // Coverage area for the "find my nearest plant" feature. Stored as
  // a centre point + radius (km); future versions can use PostGIS polygons.
  coverageLng Float?
  coverageLat Float?
  coverageKm  Float  @default(5)

  groupId String?
  group   PlantGroup? @relation(fields: [groupId], references: [id])

  plan        SubscriptionPlan @default(STARTER)
  status      TenantStatus     @default(TRIAL)
  trialEndsAt DateTime?
  billingDay  Int              @default(1)

  // Bonus the plant pays each driver per completed action, on top of
  // salary + base commission. Adjustable from the dashboard.
  refillBonusIqd      Int @default(0)
  deliveryBonusIqd    Int @default(0)
  reclaimBonusIqd     Int @default(0)
  newCustomerBonusIqd Int @default(0)

  // Plant-configurable pricing (edited from dashboard settings page)
  refillPriceIqd           Int    @default(1000)
  deliveryFeeIqd           Int    @default(0)
  freeDeliveryThresholdIqd Int?
  // Working hours displayed in customer app + used for new-order eligibility
  workingHoursStart        String @default("08:00")
  workingHoursEnd          String @default("22:00")

  // Promo budget — plant pays Ahmed (PhiBit) cash, Ahmed tops this up
  // via the platform-admin console. PromoCampaign deducts 1,000 IQD per
  // completed order while the campaign is active. Hits 0 → campaign
  // auto-expires.
  promoWalletIqd Int @default(0)

  // Onboarding checklist: when the plant owner clicks "skip the tour" on
  // the mobile-admin first-run experience, we stamp this so we don't show
  // the checklist again. NULL = not yet skipped (checklist still appears
  // until allComplete is true).
  onboardingSkippedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  tanks                Tank[]
  customers            Customer[]
  drivers              Driver[]
  refillOrders         RefillOrder[]
  expenses             Expense[]
  salaries             SalaryPayment[]
  notifications        NotificationLog[]
  subscriptions        Subscription[]
  promoCampaigns       PromoCampaign[]
  walletTopups         WalletTopup[]
  // Free-text accounting category rows (richer than the legacy enum), plus
  // recurring-expense schedules and customer invoices. Added 2026-05-28.
  expenseCategoryItems ExpenseCategoryItem[]
  recurringExpenses    RecurringExpense[]
  invoices             Invoice[]

  @@index([status])
  @@index([groupId])
}

//
// Subscription history per tenant. Newest row is the active subscription.
// Platform admin renews / upgrades by inserting a new row.
//
model Subscription {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  plan     SubscriptionPlan
  priceIqd Int // monthly fee captured at subscription time
  status   SubscriptionStatus @default(ACTIVE)

  startsAt    DateTime
  endsAt      DateTime // next renewal deadline
  cancelledAt DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId, startsAt])
  @@index([status, endsAt]) // for "expiring soon" queries
}

enum UserRole {
  OWNER
  MANAGER
  ACCOUNTANT
  DRIVER
  CUSTOMER
  VENDOR
  PLATFORM_ADMIN
}

model User {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  phone        String    @unique
  passwordHash String?
  fullName     String
  role         UserRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  driver              Driver?
  customer            Customer?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  pushTokens          PushToken[]

  @@index([tenantId, role])
}

// Expo push tokens for native push delivery. A single user can have
// multiple tokens (one per installed device — phone + tablet). We store
// the platform so we can target iOS vs Android specific behaviour later.
model PushToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String // "ios" | "android"
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

// Stores hashed OTP codes for self-service password reset (sent via otpiq
// over WhatsApp/Telegram/SMS). We hash so a DB leak doesn't reveal active
// codes. `attempts` lets us lock out brute-force guesses on a single code.
//
// Reset is only available if user.lastLoginAt is non-null — i.e. the
// customer has logged in at least once with the password the plant admin
// gave them. This stops fraud (someone guessing a phone that was bulk-
// registered but never claimed) AND saves a ton of OTP costs.
// OTP storage for self-signup (the prospect doesn't have a User row yet,
// so we key by phone instead of userId). Same hash + attempt + expiry
// pattern as PasswordResetToken.
model SignupOtpToken {
  id        String    @id @default(cuid())
  phone     String
  otpHash   String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([phone, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash   String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─── Tanks ────────────────────────────────────────────────────────────────────

enum TankCapacity {
  L350
  L500
}

enum TankStatus {
  IN_PLANT
  ASSIGNED
  AT_RISK
  RECLAIMED
  DAMAGED
}

enum TankReclaimReason {
  NON_COMPLIANCE // عدم التزام بتعليمات الشركة (no monthly refill etc.)
  MAINTENANCE // خزان للصيانة
  CUSTOMER_MOVED // الزبون انتقل لمنطقة معمل آخر
  CUSTOMER_CANCELLED // الزبون ألغى الاشتراك
  TANK_DAMAGED // خزان تالف
  OTHER
}

model Tank {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  serialNumber String
  // Per-tenant unique (NOT global): every plant uses its own numbering
  // scheme like T-1, T-2, T-3 … and two plants on the same Daari instance
  // MUST be allowed to issue the same printed sticker independently.
  // Enforced by @@unique([tenantId, qrCode]) below.
  qrCode       String
  capacity     TankCapacity
  status       TankStatus   @default(IN_PLANT)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  installedAt  DateTime?
  lastRefillAt DateTime?
  notes        String?

  // Reclaim audit: when, why, and which driver brought it back. Lets the
  // plant owner answer "where did tank T-1024 go?" at a glance.
  reclaimedAt         DateTime?
  reclaimedByDriverId String?
  reclaimReason       TankReclaimReason?
  reclaimNotes        String?
  reclaimPhotoUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refillOrders RefillOrder[]

  @@unique([tenantId, serialNumber])
  @@unique([tenantId, qrCode])
  @@index([tenantId, status])
  @@index([customerId])
}

// ─── Customers ────────────────────────────────────────────────────────────────

enum CustomerStatus {
  PENDING_APPROVAL // registered by a driver in the field; plant owner
  // must approve before the account can request refills
  // and a tank is dispatched.
  ACTIVE
  AT_RISK
  INACTIVE
  CHURNED
}

enum LocationSource {
  DRIVER_AT_INSTALL // most accurate — driver was physically at the door
  CUSTOMER_PIN // customer dropped a pin on the map
  ADMIN_MANUAL // plant typed an address, geocoded server-side
  OFFLINE_SYNC // captured offline, GPS at the moment of completion
}

model Customer {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  fullName           String
  phone              String
  whatsapp           String?
  district           String
  addressLine        String
  // PostGIS Point(longitude, latitude). Stored via raw SQL on insert.
  // Use ST_X / ST_Y to read.
  //
  // These coords always represent the *home* where the tank lives —
  // never the customer's current GPS at order time. Captured once at
  // tank install (preferred) or by the customer via pin-on-map.
  locationLng        Float?
  locationLat        Float?
  locationCapturedAt DateTime?
  locationCapturedBy LocationSource?

  // When a customer moves house, the previous home is kept for a grace
  // period so deliveries to the old address still resolve. Geofence
  // widens during the move window to absorb driver confusion.
  movedAt             DateTime?
  previousLocationLng Float?
  previousLocationLat Float?

  status CustomerStatus @default(ACTIVE)

  // Customer onboarding lifecycle. Driver installs the app on the
  // customer's phone during tank delivery, walks them through terms,
  // and `acceptedTermsAt` is stamped when the customer taps "I agree".
  // Until then, the account is provisional — they can browse but not
  // request refills (since they don't fully own the tank yet).
  acceptedTermsAt      DateTime?
  onboardedByDriverId  String?
  onboardedAt          DateTime?
  // Stamped when plant admin first approves a driver-onboarded customer.
  // `registrationBonusIqd` snapshots Tenant.newCustomerBonusIqd at that
  // exact moment so the driver's monthly salary always credits the rate
  // that was in effect when the work happened — even if the plant changes
  // the bonus rate later. Stays 0 if no driver onboarded them (admin-added
  // customer or self-signup — nothing to pay).
  approvedAt           DateTime?
  registrationBonusIqd Int       @default(0)

  balanceIqd    Int       @default(0) // running balance in dinars
  loyaltyPoints Int       @default(0) // +1 per completed refill; redeemable later
  totalRefills  Int       @default(0)
  lastRefillAt  DateTime?
  registeredAt  DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tanks          Tank[]
  refillOrders   RefillOrder[]
  invoices       Invoice[]
  addresses      CustomerAddress[]
  ratings        Rating[]
  schedules      ScheduledOrder[]

  @@unique([tenantId, phone])
  @@index([tenantId, status])
  @@index([tenantId, district])
}

// ─── Drivers ──────────────────────────────────────────────────────────────────

enum DriverStatus {
  OFFLINE
  AVAILABLE
  ON_ROUTE
  ON_BREAK
}

model Driver {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  vehiclePlate           String?
  baseSalaryIqd          Int          @default(0)
  commissionPerRefillIqd Int          @default(0)
  status                 DriverStatus @default(OFFLINE)
  currentLng             Float?
  currentLat             Float?
  lastLocationAt         DateTime?
  hiredAt                DateTime     @default(now())

  // Van stock the driver is carrying right now (for "tanks on van" UI).
  tanksFullOnVan  Int @default(0)
  tanksEmptyOnVan Int @default(0)

  refillOrders RefillOrder[]
  locations    DriverLocation[]
  salaries     SalaryPayment[]
  ratings      Rating[]
  handovers    CashHandover[]

  @@index([tenantId, status])
}

// Location pings stored for audit / replay. High write volume —
// in production, partition by month or move to TimescaleDB.
model DriverLocation {
  id         BigInt   @id @default(autoincrement())
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  lng        Float
  lat        Float
  recordedAt DateTime @default(now())

  @@index([driverId, recordedAt])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

enum RefillOrderStatus {
  PENDING
  ASSIGNED
  EN_ROUTE
  COMPLETED
  CANCELLED
  FAILED
}

enum RefillOrderKind {
  REFILL // tank refill at customer site
  TANK_DELIVERY // first install — drop off the empty tank
  TANK_RECLAIM // pick the tank back up
  WALKIN_SALE // ad-hoc sale to a non-customer (e.g. the neighbour
  // who flagged the driver down). No tank assigned;
  // customer is optional. Tracked for accounting only.
}

enum PaymentMethod {
  CASH
  ZAINCASH
  ASIA_HAWALA
  CREDIT
}

model RefillOrder {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // customerId is required for normal refills but null for WALKIN_SALE,
  // where the buyer is a one-time walk-up customer with no account.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Free-text capture for walk-in buyers (the neighbour's name + phone)
  // so the plant has *some* trace even without a Customer row.
  walkinBuyerName  String?
  walkinBuyerPhone String?
  walkinLiters     Int?

  // Idempotency key supplied by the offline client (a UUID generated at enqueue
  // time). A walk-in sale flushed twice from the offline queue dedupes to the
  // original row instead of double-recording revenue. Nullable on purpose:
  // legacy clients (Expo) and server-created rows send no key, and Postgres
  // treats NULLs as distinct in the @@unique below, so they are never blocked.
  clientRequestId String?

  tankId String?
  tank   Tank?   @relation(fields: [tankId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  // Snapshot of the chosen saved address at order time (customer can pick
  // "البيت" vs "العمل"). Null → fall back to the customer's registered
  // location. The tracking map + driver navigation read these first.
  deliveryAddressId   String?
  deliveryAddressLine String?
  deliveryDistrict    String?
  deliveryLat         Float?
  deliveryLng         Float?

  kind   RefillOrderKind   @default(REFILL)
  status RefillOrderStatus @default(PENDING)

  priceIqd      Int            @default(1000)
  paymentMethod PaymentMethod?
  paidAmountIqd Int            @default(0)
  paidAt        DateTime?

  requestedAt  DateTime  @default(now())
  scheduledFor DateTime?
  assignedAt   DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  cancelReason String?

  proofPhotoUrl String?
  qrScanned     Boolean @default(false)

  // Bonus snapshot at completion time. Stored on the order itself so
  // future bonus-rate changes don't retroactively alter past payouts.
  bonusIqd Int @default(0)

  // GPS verification: driver's coordinates at the moment of completion.
  // We compare these against the customer's registered location to flag
  // refills logged from the wrong address.
  completionLng Float?
  completionLat Float?
  gpsDistanceM  Int? // distance from customer in metres
  gpsVerified   Boolean @default(false)

  // Customer-side confirmation. After completion, we WhatsApp the customer
  // a "did you receive this refill?" prompt. They confirm or dispute within
  // 24h; unconfirmed refills are visible on the dashboard for follow-up.
  customerConfirmedAt DateTime?
  customerDisputedAt  DateTime?
  disputeReason       String?

  // Set when the order was placed during an active PromoCampaign — the
  // priceIqd above already reflects the discount snapshot. We record the
  // campaign id so completion can deduct 1,000 IQD from the tenant wallet
  // and increment the campaign's order counter atomically.
  promoCampaignId String?
  promoCampaign   PromoCampaign? @relation(fields: [promoCampaignId], references: [id])

  rating Rating?

  @@unique([tenantId, clientRequestId])
  @@index([tenantId, status])
  @@index([customerId, requestedAt])
  @@index([driverId, status])
  @@index([tenantId, customerConfirmedAt])
}

// ─── Customer-facing features (ratings, addresses, scheduled orders) ──────────

// Star rating + optional comment the customer leaves after a COMPLETED order.
// One per order (orderId unique). Feeds the driver's average score.
model Rating {
  id         String      @id @default(cuid())
  tenantId   String
  orderId    String      @unique
  order      RefillOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  driverId   String?
  driver     Driver?     @relation(fields: [driverId], references: [id])
  stars      Int // 1..5
  comment    String?
  createdAt  DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@index([driverId])
}

// Multiple saved delivery addresses per customer (home / work / …).
model CustomerAddress {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label       String // "البيت" / "العمل" / custom
  addressLine String
  district    String
  lng         Float?
  lat         Float?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([customerId])
}

enum ScheduleCadence {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

// Recurring auto-refill schedule. A BullMQ/cron job materialises a real
// RefillOrder each time `nextRunAt` is due, then advances nextRunAt.
model ScheduledOrder {
  id         String          @id @default(cuid())
  tenantId   String
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cadence    ScheduleCadence
  nextRunAt  DateTime
  addressId  String?
  active     Boolean         @default(true)
  lastRunAt  DateTime?
  createdAt  DateTime        @default(now())

  @@index([active, nextRunAt])
  @@index([customerId])
}

enum CashHandoverStatus {
  PENDING
  CONFIRMED
}

// Driver hands collected cash to the plant; plant confirms receipt.
model CashHandover {
  id          String             @id @default(cuid())
  tenantId    String
  driverId    String
  driver      Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  amountIqd   Int
  note        String?
  // Idempotency key from the client (see RefillOrder.clientRequestId). Guards a
  // double-tap / retried handover from being recorded twice. Nullable → legacy
  // clients unaffected.
  clientRequestId String?
  status      CashHandoverStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  confirmedAt DateTime?

  @@unique([tenantId, clientRequestId])
  @@index([tenantId, status])
  @@index([driverId, createdAt])
}

// ─── Accounting ───────────────────────────────────────────────────────────────

enum ExpenseCategory {
  FUEL
  MAINTENANCE
  UTILITIES
  PURCHASE
  RENT
  OTHER
}

model Expense {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  category    ExpenseCategory
  amountIqd   Int
  description String
  receiptUrl  String?
  occurredAt  DateTime        @default(now())
  createdById String?
  createdAt   DateTime        @default(now())

  // Optional richer category (user-defined named row) — supplements the
  // legacy `category` enum. Most existing rows keep this NULL and rely on
  // the enum; new entries can attach a custom category like "إيجار" with
  // a tint colour + icon for nicer UI.
  categoryItemId String?
  categoryItem   ExpenseCategoryItem? @relation(fields: [categoryItemId], references: [id])

  @@index([tenantId, occurredAt])
  @@index([tenantId, category])
  @@index([tenantId, categoryItemId])
}

// User-defined expense categories (richer companion to the legacy
// `ExpenseCategory` enum). Plant admins create categories like "إيجار",
// "كهرباء", "صيانة" with optional icon + tint colour so the dashboard
// renders them with personality. The legacy enum stays as a fallback for
// quick-entry flows and historical rows; this model is what the new UI uses.
//
// Named ExpenseCategoryItem (not ExpenseCategory) because the existing enum
// already owns the ExpenseCategory identifier in the Prisma namespace.
model ExpenseCategoryItem {
  id        String             @id @default(cuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  icon      String? // material-icon name (e.g. "bolt", "build", "home")
  color     String? // tint hex like "#3b82f6"
  createdAt DateTime           @default(now())
  expenses  Expense[]
  recurring RecurringExpense[]

  @@unique([tenantId, name])
}

// A scheduled recurring expense. The accounting scheduler runs daily and
// converts any RecurringExpense whose `nextDueAt` has elapsed into an
// actual Expense row, then advances `nextDueAt` by `cadence`. Owners can
// pause one without deleting it by flipping `isActive`.
model RecurringExpense {
  id          String               @id @default(cuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    ExpenseCategoryItem? @relation(fields: [categoryId], references: [id])
  amountIqd   Int
  description String
  cadence     String // "WEEKLY" | "MONTHLY" | "YEARLY"
  nextDueAt   DateTime
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())

  @@index([tenantId, nextDueAt])
}

// Customer-facing invoice. Issued by the plant for B2B accounts or bulk
// pre-paid refill blocks. `items` is a free-form JSON array — keeps the
// schema flexible without a full line-item table. `invoiceNumber` is
// sequential per tenant (INV-YYYY-NNNN), enforced by @@unique.
model Invoice {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  invoiceNumber String
  issuedAt      DateTime  @default(now())
  dueAt         DateTime?
  status        String    @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE | VOID
  subtotalIqd   Int
  taxIqd        Int       @default(0)
  totalIqd      Int
  paidAmountIqd Int       @default(0)
  notes         String?
  items         Json // [{ description, liters, unitPrice, subtotal }]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
}

model SalaryPayment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id])

  periodStart   DateTime
  periodEnd     DateTime
  baseIqd       Int
  commissionIqd Int
  bonusIqd      Int       @default(0)
  deductionIqd  Int       @default(0)
  netIqd        Int
  paidAt        DateTime?
  note          String?
  createdAt     DateTime  @default(now())

  @@index([tenantId, periodStart])
}

// ─── Notifications ────────────────────────────────────────────────────────────

enum NotificationChannel {
  WHATSAPP
  SMS
  PUSH
}

enum NotificationKind {
  REFILL_REMINDER
  REFILL_WARNING
  TANK_RECLAIM_NOTICE
  DRIVER_EN_ROUTE
  ORDER_COMPLETED
  SUBSCRIPTION_REMINDER_14D
  SUBSCRIPTION_REMINDER_7D
  SUBSCRIPTION_EXPIRING_3D
  SUBSCRIPTION_EXPIRED
  CUSTOM
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model NotificationLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  channel    NotificationChannel
  kind       NotificationKind
  recipient  String // phone number
  body       String
  status     NotificationStatus  @default(QUEUED)
  providerId String? // upstream message id
  errorMsg   String?
  sentAt     DateTime?
  createdAt  DateTime            @default(now())

  // Inbox state — the mobile-admin app shows a notifications inbox per
  // tenant. `readAt` is stamped when the admin opens the message; a NULL
  // value means it's still unread. We don't track per-user read state
  // here because every plant admin sees the same shared inbox (matches
  // the audit-log behaviour). When mobile-admin gets multi-user fan-out
  // later, migrate to a join table.
  readAt DateTime?

  // Optional short title (the inbox list shows title + first line of body).
  // Reminders / system messages set this; legacy WhatsApp/SMS rows keep it
  // null and the list falls back to using the kind enum for the heading.
  title String?

  @@index([tenantId, kind, createdAt])
  @@index([status])
  @@index([tenantId, readAt])
}

// ─── Plant power features (stock + audit) ─────────────────────────────────

// Water inventory at the plant. One row per tenant. Driver completes a
// refill → currentLiters -= tank capacity. Plant admin tops up by setting
// currentLiters back to a fresh value. lowThresholdLiters triggers a
// dashboard banner so the plant doesn't accidentally run out mid-day.
model WaterStock {
  id                 String    @id @default(cuid())
  tenantId           String    @unique
  currentLiters      Int       @default(0)
  capacityLiters     Int       @default(20000)
  lowThresholdLiters Int       @default(2000)
  lastTopUpAt        DateTime?
  lastTopUpLiters    Int?
  updatedAt          DateTime  @updatedAt
  createdAt          DateTime  @default(now())
}

// Append-only audit log of admin actions — who changed the price, who
// approved which customer, who reset which password. Keeps the plant
// owner accountable and helps trace mysterious changes later.
//
// `before` and `after` are JSON snapshots so we can show diffs in the UI.
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorId    String // User.id
  actorName  String
  action     String // "settings.update", "customer.approve", "tank.assign", etc.
  entityType String? // "Customer" | "Tank" | "Tenant" | ...
  entityId   String?
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([actorId])
}

// ─── Revenue: paid promotional blasts ────────────────────────────────────

// Each row is a "marketing blast" the plant admin paid to send to all
// (or a segment of) their customers. priceIqd is what the plant was
// charged. channel = PUSH (free for Daari, ~5,000 IQD) or WHATSAPP
// (cost to Daari ~5 IQD/msg, charged ~10 IQD + 10/msg to plant).
enum PromoChannel {
  PUSH
  WHATSAPP
}

enum PromoStatus {
  QUEUED
  SENT
  FAILED
}

model PromoNotification {
  id            String       @id @default(cuid())
  tenantId      String
  channel       PromoChannel
  title         String
  body          String
  audienceCount Int // number of customers targeted
  sentCount     Int          @default(0)
  failedCount   Int          @default(0)
  priceIqd      Int // what the plant was charged
  status        PromoStatus  @default(QUEUED)
  scheduledFor  DateTime?
  sentAt        DateTime?
  createdById   String // User.id who composed it
  createdAt     DateTime     @default(now())

  @@index([tenantId, createdAt])
}

//
// ─── Wallet + Promo system (added 2026-05-26) ──────────────────────
//
// Money flow:
//   1. Plant owner messages Ahmed (PhiBit) requesting promo top-up
//   2. Bank/cash transfer happens off-platform
//   3. Ahmed opens platform-admin console + records the top-up
//      → tenant.promoWalletIqd += amount, WalletTopup row inserted
//   4. Plant owner creates a PromoCampaign (new price + duration up to 48h)
//   5. Push notification reaches every active customer
//   6. Each customer sees the refill CTA morph into "Order Now — 7,000 د.ع"
//      with a countdown ending at PromoCampaign.endAt
//   7. Order placed during the window → priceIqd snapshots the discounted
//      price + promoCampaignId is set on the order
//   8. Order completed → 1,000 IQD deducted from tenant wallet
//   9. Campaign auto-expires when: (a) endAt elapses, (b) wallet < cost,
//      or (c) owner manually pauses
//

enum PromoCampaignStatus {
  ACTIVE
  PAUSED_BY_OWNER
  EXPIRED
  OUT_OF_BUDGET
}

model PromoCampaign {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Snapshot of the plant's normal refill price at the moment the campaign
  // was created. Stored so the customer-facing "X بدلاً من Y" stays honest
  // even if the plant edits refillPriceIqd later.
  originalPriceIqd Int
  // The promoted price customers actually pay during the window.
  promoPriceIqd    Int

  // Wallet cost per completed order. Captured here so future repricing
  // (Ahmed bumping from 1000→1500 next year) doesn't retroactively
  // re-charge historical campaigns.
  costPerOrderIqd Int @default(1000)

  // The window — backend enforces (endAt - startAt) <= 48h on create.
  startAt DateTime
  endAt   DateTime

  status         PromoCampaignStatus @default(ACTIVE)
  pausedAt       DateTime?
  pausedByUserId String?

  // Snapshots + live counters (updated on order completion + send fanout)
  walletBalanceAtStartIqd Int
  pushSentCount           Int @default(0)
  pushFailedCount         Int @default(0)
  orderCount              Int @default(0)
  totalDeductedIqd        Int @default(0)
  totalRevenueIqd         Int @default(0)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders RefillOrder[]

  @@index([tenantId, status, startAt])
  @@index([tenantId, endAt])
}

enum WalletTopupSource {
  CASH
  BANK_TRANSFER
  ZAINCASH
  ASIACELL
  OTHER
}

model WalletTopup {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  amountIqd       Int
  balanceAfterIqd Int // snapshot of wallet AFTER this topup

  source    WalletTopupSource @default(CASH)
  reference String? // bank ref / receipt #
  note      String?

  // The PhiBit staff member who recorded this top-up. Always a
  // PLATFORM_ADMIN user (Ahmed for now). Not nullable — every top-up
  // must be traceable to who recorded it.
  recordedById String

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

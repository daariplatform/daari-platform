# =============================================================================
# Daari Backend — Production env template
# =============================================================================
# Copy to /var/www/daari-api/.env on the VPS and fill in the real values.
# NEVER commit the filled file to git. The systemd unit reads from this path.
#
# Generate cryptographic secrets with:
#   openssl rand -hex 32

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
APP_VERSION=0.1.0

# CORS origins. Comma-separated. Mobile apps don't need this (no Origin
# header), but the dashboard does.
CORS_ORIGINS=https://daari-admin.phi-bit.com

# ─── Database ────────────────────────────────────────────────────────────────
# Postgres with the PostGIS extension already enabled in the daari database.
DATABASE_URL=postgresql://daari:CHANGE_ME@localhost:5432/daari?schema=public

# Redis for sessions/cache/BullMQ (NestJS schedule + throttler).
REDIS_URL=redis://127.0.0.1:6379/0

# ─── Auth ────────────────────────────────────────────────────────────────────
# Use `openssl rand -hex 64` for each. The refresh secret can match
# JWT_SECRET, but rotating it independently is cleaner.
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

# Self-service customer signup via SMS OTP. Keep OFF at launch (we ship
# plant-created accounts only). Flip ON only after a real SMS provider
# is wired into auth.service.ts.
OTP_SELF_SIGNUP_ENABLED=false

# ─── Notifications ───────────────────────────────────────────────────────────
# WhatsApp Business Cloud API (Meta). Get these from
# https://business.facebook.com → WhatsApp → API Setup.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Firebase Cloud Messaging (push notifications). Service account JSON path.
FCM_SERVICE_ACCOUNT_PATH=/var/www/daari-api/google-service-account.json

# SMS fallback (Zain / Asiacell). Leave blank to disable.
SMS_PROVIDER=
SMS_API_KEY=

# ─── Reminders (cron tuning) ────────────────────────────────────────────────
# Days since last refill that trigger the friendly reminder.
REMINDER_FIRST_DAYS=25
# Days that trigger the AT_RISK status + "we're about to reclaim the tank"
# warning.
REMINDER_WARNING_DAYS=35

# ─── Monitoring ──────────────────────────────────────────────────────────────
# Create the project at https://sentry.io and paste the DSN here.
SENTRY_DSN=

# ─── Object storage (refill proof photos) ───────────────────────────────────
# DigitalOcean Spaces or any S3-compatible endpoint.
S3_ENDPOINT=https://fra1.digitaloceanspaces.com
S3_REGION=fra1
S3_BUCKET=daari-proofs
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Feature flags ───────────────────────────────────────────────────────────
# Phase 3 — flip on once vendor onboarding + matching engine is launched.
FEATURE_VENDORS=false

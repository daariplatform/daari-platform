# =============================================================================
# Daari Backend — Production env template
# =============================================================================
# Copy to /var/www/daari-water-api/.env on the VPS and fill in the real values.
# NEVER commit the filled file to git. The systemd unit reads from this path.
#
# ملاحظة: أسماء المتغيّرات هنا مطابِقة لما يقرأه الكود فعلاً (تأكّدنا بالتدقيق).
# Generate cryptographic secrets with:
#   openssl rand -hex 32

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
# MUST match the nginx upstream (deploy/nginx/daari-water-api.conf → 3004) and
# the systemd unit. The API listens on Number(process.env.PORT ?? 3000).
PORT=3004
APP_VERSION=0.1.0
# يُستخدم لبناء روابط صور إثبات التسليم وروابط التقارير (uploads/reports).
# اضبطه على الأصل العام الذي يخدم الملفات عبر nginx.
APP_URL=https://api.phi-bit.com

# CORS origins. Comma-separated. Mobile apps don't need this (no Origin
# header), but the dashboard does.
CORS_ORIGINS=https://daari-admin.phi-bit.com

# ─── Database ────────────────────────────────────────────────────────────────
# Postgres with the PostGIS extension already enabled in the daari database.
DATABASE_URL=postgresql://daari:CHANGE_ME@localhost:5432/daari?schema=public

# Redis for cache/BullMQ/throttler. الكود يقرأ REDIS_HOST/REDIS_PORT (لا REDIS_URL).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Auth ────────────────────────────────────────────────────────────────────
# Use `openssl rand -hex 64`. يجب أن يكون JWT_SECRET >= 32 محرفاً وإلا يرفض
# الخادم الإقلاع في الإنتاج.
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
# الكود يقرأ JWT_EXPIRES_IN بصيغة مدّة (مثل 15m / 1h) لا ثواني.
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_64_HEX_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# Self-service customer signup via SMS OTP. Keep OFF at launch (we ship
# plant-created accounts only). لا تُفعّله قبل ربط تحقّق OTP حقيقي.
OTP_SELF_SIGNUP_ENABLED=false
# مزوّد OTP (otpiq) لاستعادة كلمة السر عبر واتساب/SMS.
OTPIQ_API_KEY=

# ─── Notifications ───────────────────────────────────────────────────────────
# WhatsApp Business Cloud API (Meta). الكود يقرأ WHATSAPP_TOKEN و WHATSAPP_PHONE_ID.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Firebase Cloud Messaging (push notifications). Service account JSON path.
FCM_SERVICE_ACCOUNT_PATH=/var/www/daari-water-api/google-service-account.json

# SMS fallback (Zain / Asiacell). الكود يقرأ SMS_PROVIDER_URL/SMS_PROVIDER_KEY/SMS_SENDER.
# اتركها فارغة لتعطيل القناة.
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
SMS_SENDER=Daari

# Email (Zoho SMTP) — الكود يقرأ ZOHO_SMTP_HOST/PORT/USER/PASS.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=

# ─── Uploads (proof-of-delivery photos) ─────────────────────────────────────
# الكود الحالي يحفظ الصور على القرص المحلي ويخدمها nginx على مسار ثابت.
# هذا هو المجلّد الفعلي الذي يقرأه الكود (uploads/reports controllers).
UPLOADS_DIR=/var/www/daari-water-api/uploads

# ─── Reminders (cron tuning) ────────────────────────────────────────────────
# Days since last refill that trigger the friendly reminder.
REMINDER_FIRST_DAYS=25
# Days that trigger the AT_RISK status + "we're about to reclaim the tank"
# warning.
REMINDER_WARNING_DAYS=35

# ─── Monitoring ──────────────────────────────────────────────────────────────
# Sentry: project created under Ahmed's existing PhiBit org (do NOT create a
# new org). Project name in Sentry: `daari-backend`. Paste the DSN here.
SENTRY_DSN=

# Pino log level: trace | debug | info | warn | error | fatal.
LOG_LEVEL=info

# Slack webhook for production error firehose (optional fallback).
SLACK_WEBHOOK_URL=

# ─── Object storage (مستقبلي — غير مستعمَل بعد) ──────────────────────────────
# الكود الحالي يخدم الصور من UPLOADS_DIR عبر nginx، لا من S3. هذه للتوسّع لاحقاً.
S3_ENDPOINT=https://fra1.digitaloceanspaces.com
S3_REGION=fra1
S3_BUCKET=daari-proofs
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Feature flags ───────────────────────────────────────────────────────────
# Phase 3 — flip on once vendor onboarding + matching engine is launched.
FEATURE_VENDORS=false

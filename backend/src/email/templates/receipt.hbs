<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>إيصال تعبئة — داري</title>
</head>
<body style="margin:0;padding:0;background:#f1f5f9;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Tahoma,Arial,sans-serif;direction:rtl;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f1f5f9;padding:24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 14px rgba(15,23,42,.08);">
          <tr>
            <td style="background:linear-gradient(135deg,#0284c7 0%,#38bdf8 100%);padding:32px 24px;text-align:center;">
              <div style="display:inline-block;width:64px;height:64px;border-radius:20px;background:rgba(255,255,255,.18);line-height:64px;font-size:32px;border:1px solid rgba(255,255,255,.3);">💧</div>
              <h1 style="color:#fff;margin:14px 0 6px;font-size:24px;">داري</h1>
              <p style="color:rgba(255,255,255,.9);margin:0;font-size:13px;">ماء نقي يصل لباب بيتك</p>
            </td>
          </tr>
          <tr>
            <td style="padding:28px 24px;">
              <h2 style="margin:0 0 8px;color:#0f172a;font-size:18px;">مرحباً {{customerName}}،</h2>
              <p style="margin:0 0 20px;color:#475569;font-size:14px;line-height:1.7;">
                تم إكمال طلب التعبئة من معمل <strong style="color:#0284c7;">{{tenantName}}</strong>. شكراً لاختيارك داري.
              </p>

              <table role="presentation" width="100%" cellpadding="10" cellspacing="0" style="background:#f8fafc;border-radius:12px;font-size:14px;color:#1e293b;">
                <tr>
                  <td style="color:#64748b;width:40%;">رقم الطلب</td>
                  <td style="font-family:Menlo,Monaco,monospace;direction:ltr;text-align:right;">{{orderId}}</td>
                </tr>
                <tr>
                  <td style="color:#64748b;border-top:1px solid #e2e8f0;">الكمية</td>
                  <td style="border-top:1px solid #e2e8f0;">{{refillLiters}} لتر</td>
                </tr>
                <tr>
                  <td style="color:#64748b;border-top:1px solid #e2e8f0;">المبلغ</td>
                  <td style="border-top:1px solid #e2e8f0;color:#0284c7;font-weight:700;">{{priceFormatted}} د.ع</td>
                </tr>
                <tr>
                  <td style="color:#64748b;border-top:1px solid #e2e8f0;">التاريخ</td>
                  <td style="border-top:1px solid #e2e8f0;">{{completedAtArabic}}</td>
                </tr>
              </table>

              <p style="margin:24px 0 0;color:#475569;font-size:13px;line-height:1.7;">
                إذا كان لديك أي ملاحظة حول جودة الخدمة، يرجى التواصل مع معملك مباشرة عبر التطبيق.
              </p>
            </td>
          </tr>
          <tr>
            <td style="background:#f8fafc;padding:18px 24px;text-align:center;border-top:1px solid #e2e8f0;">
              <p style="margin:0;color:#94a3b8;font-size:11px;">
                مدعوم من <a href="https://phi-bit.com" style="color:#0284c7;text-decoration:none;">Phi-Bit</a> · {{tenantName}}
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>

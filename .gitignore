.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
.eas-build-local/

# ─── React Native ───────────────────────────────────
# NOTE: android/ and ios/ are committed in mobile-customer/ and mobile-worker/
# for the bare-workflow EAS Build path. Per-project .gitignore handles
# build artifacts (android/build/, android/.gradle/, ios/Pods/, etc.).
#
# Do NOT add `android/` or `ios/` here — eas-cli reads .gitignore when
# copying the project to its build sandbox (see vcs/local.js
# makeShallowCopyAsync). A blanket `android/` rule here causes EAS to
# strip the committed prebuild output before the build runs, which then
# fails with "ENOENT: no such file or directory ... android/gradlew" in
# the FIX_GRADLEW phase.

# ─── Next.js ────────────────────────────────────────
.next/
out/
build/

# ─── PWA (next-pwa build output — regenerated on every build) ──
# These are Workbox artifacts emitted by `next build`; committing them just
# causes churn and risks shipping a stale service worker.
dashboard/public/sw.js
dashboard/public/sw.js.map
dashboard/public/workbox-*.js
dashboard/public/workbox-*.js.map
platform-console/public/sw.js
platform-console/public/sw.js.map
platform-console/public/workbox-*.js
platform-console/public/workbox-*.js.map

# ─── TypeScript ─────────────────────────────────────
*.tsbuildinfo

# ─── Backend (NestJS) ──────────────────────────────
backend/dist/
backend/coverage/

# ─── Prisma (don't commit local SQLite or migrations
#     until reviewed; keep schema only) ──────────────
backend/prisma/migrations/dev/
backend/prisma/*.db
backend/prisma/*.db-journal

# ─── IDE / Editor ──────────────────────────────────
.vscode/
.idea/
# Claude Code per-machine settings (never committed) + any stray backups.
.claude/settings.local.json
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db

